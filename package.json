{
  "name": "reqzen-desktop",
  "version": "0.2.6",
  "private": true,
  "homepage": "https://kavoryx.github.io/reqzen/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kavoryx/reqzen.git"
  },
  "keywords": [
    "api-client",
    "api-explorer",
    "api-testing",
    "desktop-app",
    "developer-tools",
    "electron",
    "local-first",
    "openapi",
    "rest-api",
    "source-code-scanner"
  ],
  "description": "Reqzen is a local-first, AI-assisted API explorer and REST API client: scan Java, JavaScript/TypeScript, and Python projects or OpenAPI 3 definitions in GitHub repositories, search APIs, plan and test requests, and export Postman collections.",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac-signed": "npm run build && electron-builder --mac --config.mac.notarize=true",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "productName": "Reqzen",
  "build": {
    "appId": "com.apiexplorer.desktop",
    "productName": "Reqzen",
    "forceCodeSigning": false,
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "icon": "build/icon.png",
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "dmg": {
      "title": "Reqzen ${version}"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
