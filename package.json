{
  "name": "reqzen-desktop",
  "version": "0.2.4",
  "private": true,
  "description": "Reqzen is a local-first, AI-assisted API explorer and REST API client: scan Java, JavaScript/TypeScript, and Python projects or OpenAPI 3 definitions in GitHub repositories, search APIs, plan and test requests, and export Postman collections.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac -c.mac.identity=null -c.mac.notarize=false --publish never",
    "dist:mac-signed": "electron-builder --mac",
    "dist:win": "electron-builder --win --publish never",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "productName": "Reqzen",
  "build": {
    "appId": "com.apiexplorer.desktop",
    "productName": "Reqzen",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "icon": "build/icon.png",
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "Reqzen ${version}"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
